# Copy this file to .env and fill in the values. Never commit .env.
# The Unity editor turns .env into Resources/AppSecrets.asset (gitignored) on load and before builds.
# Process environment variables with the same names take precedence (useful for CI).
# See Docs/Secrets.md.

# Auki posemesh app credentials (https://console.auki.network)
AUKI_APP_KEY=
AUKI_APP_SECRET=

# Amplitude analytics (https://amplitude.com)
AMPLITUDE_API_KEY=

# Reown / WalletConnect project id (https://cloud.reown.com)
REOWN_PROJECT_ID=

# Alchemy API key for NFT ownership checks on Base (https://alchemy.com)
ALCHEMY_API_KEY=
